# === WhatsApp Business Cloud API ===
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_TOKEN=your_meta_api_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v21.0

# === OCR Service ===
# Primary: AZAPI.ai Aadhaar OCR (recommended for production)
AZAPI_API_KEY=your_azapi_key_here
AZAPI_ENDPOINT=https://api.azapi.ai/v1/aadhaar-ocr
# Fallback: set to "tesseract" to use local pytesseract+OpenCV
OCR_PROVIDER=azapi
OCR_MIN_CONFIDENCE=95

# === Tally Prime ===
TALLY_HOST=http://localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=Your Company Name
TALLY_VOUCHER_TYPE=Receipt
TALLY_LEDGER_GROUP=Sundry Debtors
TALLY_CONTRA_LEDGER=Cash
TALLY_DEFAULT_AMOUNT=0.00

# === Cheque PDF Generation ===
CHEQUE_OUTPUT_DIR=./cheques
CHEQUE_BANK_NAME=State Bank of India
CHEQUE_ACCOUNT_NUMBER=your_account_number

# === Database (SQLite audit log) ===
DB_PATH=./audit.db

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# === Security ===
RATE_LIMIT_PER_MINUTE=30
